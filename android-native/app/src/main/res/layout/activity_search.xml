<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cars_bg"
    android:layoutDirection="rtl">

    <!-- Header & Search Bar -->
    <LinearLayout
        android:id="@+id/headerSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cars_white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnSearchBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_search_input"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/cars_text" />

            <!-- Input Box -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/cars_text_muted" />

                <EditText
                    android:id="@+id/edtSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="ابحث عن ماركة، موديل، مدينة..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/cars_text"
                    android:textColorHint="@color/cars_text_muted"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="@color/cars_text_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Result count & filter summary -->
        <TextView
            android:id="@+id/txtResultsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="جاري تحميل السيارات..."
            android:textColor="@color/cars_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/cars_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="لا توجد نتائج مطابقة لبحثك"
            android:textColor="@color/cars_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="جرب البحث بكلمات أخرى أو اختر ماركة مختلفة"
            android:textColor="@color/cars_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Results List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/headerSearch"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Unified Bottom Navigation Bar -->
    <include layout="@layout/view_bottom_nav" />

</RelativeLayout>
