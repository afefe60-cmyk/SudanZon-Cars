<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cars_bg"
    android:layoutDirection="rtl">

    <!-- Top Conversation Header -->
    <LinearLayout
        android:id="@+id/headerChatConv"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/cars_white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/btnChatBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_search_input"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/cars_text" />

        <LinearLayout
            android:id="@+id/headerSellerInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtChatSellerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="معرض النخبة للسيارات"
                android:textColor="@color/cars_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChatCarContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="متصل الآن • بخصوص السيارة"
                android:textColor="@color/cars_green"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnChatCallDirect"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_call"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_call"
            app:tint="@color/cars_white" />
    </LinearLayout>

    <!-- Messages Container -->
    <ScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutChatInput"
        android:layout_below="@id/headerChatConv"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutMessagesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Car Reference Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCarReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/cars_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_directions"
                        app:tint="@color/cars_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtRefCarTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="تويوتا لاندكروزر VXR 2023"
                            android:textColor="@color/cars_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="إعلان موثق عبر منصة سودان زون"
                            android:textColor="@color/cars_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Seller Bubble (Incoming) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:maxWidth="280dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مرحباً بك! شكراً لاهتمامك، يسعدنا الإجابة عن أي استفسار حول حالة السيارة وموعد المعاينة والفحص."
                    android:textColor="@color/cars_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="10:30 ص"
                    android:textColor="@color/cars_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:id="@+id/layoutChatInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/cars_white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/edtChatMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:hint="اكتب رسالتك للمعلن..."
            android:inputType="textShortMessage"
            android:paddingHorizontal="14dp"
            android:textColor="@color/cars_text"
            android:textColorHint="@color/cars_text_muted"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_call"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/cars_white" />
    </LinearLayout>

</RelativeLayout>
