<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cars_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnAccountBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="رجوع" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="حسابي"
                android:textColor="@color/cars_primary_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnAccountSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="الإعدادات" />
        </RelativeLayout>

        <!-- User Profile Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar Container -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/btn_add_circle">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="40sp" />
            </FrameLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/txtAccountName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="محمد أحمد علي"
                android:textColor="@color/cars_primary_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Verified Badge -->
            <TextView
                android:id="@+id/txtAccountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="✔ عضو موثق"
                android:textColor="@color/cars_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Stats Row: إعلاناتي | المفضلة | المحادثات -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <!-- 1. Listings -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚗 5"
                        android:textColor="@color/cars_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="إعلاناتي"
                        android:textColor="@color/cars_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 2. Favorites -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤️ 12"
                        android:textColor="@color/cars_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="المفضلة"
                        android:textColor="@color/cars_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 3. Chats -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 8"
                        android:textColor="@color/cars_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="المحادثات"
                        android:textColor="@color/cars_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Manage / Auth Button -->
            <Button
                android:id="@+id/btnAccountAction"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_whatsapp"
                android:text="تسجيل الدخول / فتح حساب"
                android:textColor="@color/cars_white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Menu Card List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- Item 1: إعلاناتي -->
            <LinearLayout
                android:id="@+id/menuMyCars"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚗  إعلاناتي"
                    android:textColor="@color/cars_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textColor="@color/cars_text_muted"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Item 2: المحادثات -->
            <LinearLayout
                android:id="@+id/menuChats"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💬  المحادثات"
                    android:textColor="@color/cars_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textColor="@color/cars_text_muted"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Item 3: المفضلة -->
            <LinearLayout
                android:id="@+id/menuFavorites"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐  المفضلة"
                    android:textColor="@color/cars_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textColor="@color/cars_text_muted"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Item 4: الإشعارات -->
            <LinearLayout
                android:id="@+id/menuNotifications"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔔  الإشعارات"
                    android:textColor="@color/cars_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textColor="@color/cars_text_muted"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Item 5: تسجيل الخروج -->
            <LinearLayout
                android:id="@+id/menuLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/txtLogoutLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚪  تسجيل الخروج"
                    android:textColor="#EF4444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textColor="#EF4444"
                    android:textSize="20sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Brand Footer Logo -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_header"
            android:contentDescription="SudanZon Cars" />

    </LinearLayout>
</ScrollView>
