<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cars_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btnAddCarBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="رجوع" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="إضافة إعلان سيارة"
                android:textColor="@color/cars_primary_navy"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="عنوان الإعلان *"
                android:textColor="@color/cars_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAddTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_search_input"
                android:hint="مثال: تويوتا كامري 2022 بحالة ممتازة"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cars_text"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- Brand & Model Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="الماركة"
                        android:textColor="@color/cars_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtAddBrand"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_input"
                        android:hint="تويوتا، هيونداي..."
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/cars_text"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="الموديل"
                        android:textColor="@color/cars_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtAddModel"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_input"
                        android:hint="لاندكروزر، كورولا..."
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/cars_text"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Year & City Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="سنة الصنع"
                        android:textColor="@color/cars_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtAddYear"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_input"
                        android:hint="2022"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/cars_text"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="المدينة / الولاية"
                        android:textColor="@color/cars_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtAddCity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_input"
                        android:hint="بورتسودان، الخرطوم..."
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/cars_text"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Price in SDG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="السعر المطلوب (بالجنيه السوداني ج.س) *"
                android:textColor="@color/cars_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAddPrice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_search_input"
                android:hint="مثال: 65000000"
                android:inputType="numberDecimal"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cars_text"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- WhatsApp Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="رقم الواتساب للتواصل *"
                android:textColor="@color/cars_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAddPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_search_input"
                android:hint="0912345678"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cars_text"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnAddCarSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_whatsapp"
                android:text="نشر إعلان السيارة الآن"
                android:textColor="@color/cars_white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
