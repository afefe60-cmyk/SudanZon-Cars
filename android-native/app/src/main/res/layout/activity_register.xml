<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cars_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header with Back Button and Logo -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btnRegisterBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="رجوع" />

            <ImageView
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_centerInParent="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_header"
                android:contentDescription="SudanZon Cars" />
        </RelativeLayout>

        <!-- Welcome Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="إنشاء حساب جديد"
            android:textColor="@color/cars_primary_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="انضم إلى مجتمع سيارات سودان زون للبيع والشراء المباشر"
            android:textColor="@color/cars_text_muted"
            android:textSize="13sp" />

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Full Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="الاسم الكامل"
                android:textColor="@color/cars_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtRegName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_search_input"
                android:hint="مثال: محمد أحمد علي"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cars_text"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- Phone Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="رقم الهاتف للتواصل"
                android:textColor="@color/cars_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtRegPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_search_input"
                android:hint="0912345678"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cars_text"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- City Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="المدينة / الولاية"
                android:textColor="@color/cars_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtRegCity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_search_input"
                android:hint="بورتسودان، الخرطوم، عطبرة..."
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cars_text"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- Password Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="كلمة المرور"
                android:textColor="@color/cars_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtRegPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_search_input"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/cars_text"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnRegSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_whatsapp"
                android:text="إنشاء الحساب"
                android:textColor="@color/cars_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Login Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="لديك حساب بالفعل؟ "
                    android:textColor="@color/cars_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تسجيل الدخول"
                    android:textColor="@color/cars_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
